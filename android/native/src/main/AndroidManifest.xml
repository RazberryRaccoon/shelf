<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reading your ROMs folders on internal storage and the SD card -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <!-- Listing your apps and finding installed emulators -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- OpenGL ES 3, which Filament draws with -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />

    <application
        android:label="Shelf Native"
        android:icon="@drawable/ic_shelf"
        android:roundIcon="@drawable/ic_shelf"
        android:theme="@style/Shelf"
        android:hardwareAccelerated="true"
        android:allowBackup="false">

        <activity
            android:name="com.razberryraccoon.shelf.ShelfActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:resizeableActivity="false"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboard|keyboardHidden|navigation|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hands ROM files to emulators that ask for a content:// link instead of a file path -->
        <provider
            android:name="com.razberryraccoon.shelf.RomProvider"
            android:authorities="${applicationId}.roms"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
